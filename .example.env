# OpenAI OAuth browser flow.
# Copy these values into .env before running:
# npm run openai:oauth
OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Optional OAuth client secret. Leave blank for public PKCE clients.
OPENAI_OAUTH_CLIENT_SECRET=

# Defaults to the package OpenAI OAuth scope when blank.
OPENAI_OAUTH_SCOPE=openid profile email offline_access api.connectors.read api.connectors.invoke

# Local callback listener used during the browser flow. The upstream client is
# registered for localhost ports 1455 and 1457; switch to 1457 if 1455 is busy.
OPENAI_OAUTH_CALLBACK_HOST=localhost
OPENAI_OAUTH_CALLBACK_PORT=1455
OPENAI_OAUTH_CALLBACK_PATH=/auth/callback

# The script writes the resulting exact bearer authorization header here.
OPENAI_OAUTH_OUTPUT_KEY=OPENAI_AUTHORIZATION
OPENAI_AUTHORIZATION=

# Doric A2A initial message sender.
# Run the server first, then:
# npm run doric:spawn-agent
DORIC_AGENT_CARD_URL=http://127.0.0.1:4123/.well-known/agent-card.json
DORIC_GITHUB_REPO_URL=https://github.com/example/repo
DORIC_GITHUB_TOKEN=
DORIC_PROVIDER_ID=openai
DORIC_PROVIDER_TYPE=openai
DORIC_PROVIDER_TOKEN=
DORIC_MODEL_ID=default
DORIC_MODEL_PROVIDER=openai
DORIC_MODEL_NAME=gpt-5
DORIC_MODEL_REASONING=
DORIC_MODEL_INTERNAL_KEY=
DORIC_TASK_ID=coding
DORIC_TASK_MODEL=default
DORIC_CONTEXT_ID=
DORIC_INITIAL_PROMPT=Implement the requested change.

# Doric Mosaic persistence and the default OpenRouter provider.
DORIC_DATABASE_URL=
DORIC_POSTGRES_USER=
DORIC_POSTGRES_PASSWORD=
DORIC_POSTGRES_DB=
DORIC_POSTGRES_PORT=5432
# Native source runs leave sandbox SSH disabled unless this is exactly `true`.
# The Doric runtime image and Compose profiles default it to `true` because the
# image contains the pinned Dropbear binary required by both sandbox providers.
DORIC_SANDBOX_SSH=
OPENROUTER_API_KEY=
