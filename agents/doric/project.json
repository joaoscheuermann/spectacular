{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "doric",
  "projectType": "application",
  "sourceRoot": "agents/doric/src",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node agents/doric/dist/index.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node agents/doric/dist/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p agents/doric/tsconfig.spec.json",
          "node --test agents/doric/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
