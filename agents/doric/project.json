{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "doric",
  "projectType": "application",
  "sourceRoot": "agents/doric/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "build-bundles"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "agents/doric/dist",
        "main": "agents/doric/src/index.ts",
        "tsConfig": "agents/doric/tsconfig.lib.json",
        "clean": false
      }
    },
    "build-bundles": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/bundles"],
      "options": {
        "command": "nx run-many --target=build --projects=bundle-core,bundle-git --parallel=2"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p agents/doric/tsconfig.spec.json",
          "node --test agents/doric/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
