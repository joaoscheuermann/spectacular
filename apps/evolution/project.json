{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "evolution",
  "projectType": "application",
  "sourceRoot": "apps/evolution/src",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/evolution/dist/index.js",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p apps/evolution/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/evolution/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "node -e \"require('node:fs').rmSync('apps/evolution/dist-tests',{recursive:true,force:true})\"",
          "tsc -p apps/evolution/tsconfig.spec.json",
          "node --test apps/evolution/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
