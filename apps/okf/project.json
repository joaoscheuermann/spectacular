{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "okf",
  "projectType": "application",
  "sourceRoot": "apps/okf/src",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/okf/dist/index.js",
        "forwardAllArgs": true
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/okf/dist/index.js",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "node -e \"require('node:fs').rmSync('apps/okf/dist-tests', { recursive: true, force: true })\"",
          "tsc -p apps/okf/tsconfig.spec.json",
          "node --test apps/okf/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/okf/tsconfig.lib.json --noEmit"
      }
    }
  },
  "tags": []
}
