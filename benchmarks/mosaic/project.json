{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mosaic-benchmark",
  "projectType": "application",
  "sourceRoot": "benchmarks/mosaic/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "esbuild benchmarks/mosaic/src/cli.ts --bundle --platform=node --format=esm --target=node22 --conditions=@org/source --legal-comments=none --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=benchmarks/mosaic/dist/mosaic-bench-acp.mjs",
          "esbuild benchmarks/mosaic/src/host.ts --bundle --platform=node --format=esm --target=node22 --conditions=@org/source --legal-comments=none --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=benchmarks/mosaic/dist/mosaic-bench-host.mjs"
        ],
        "parallel": false
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node benchmarks/mosaic/dist/mosaic-bench-host.mjs",
        "forwardAllArgs": true
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["{projectRoot}/dist/mosaic-bench-acp.mjs.sha256"],
      "options": {
        "command": "node benchmarks/mosaic/dist/mosaic-bench-acp.mjs release"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "tsc -p benchmarks/mosaic/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "node -e \"require('node:fs').rmSync('benchmarks/mosaic/dist-tests',{recursive:true,force:true})\"",
          "tsc -p benchmarks/mosaic/tsconfig.spec.json",
          "node --test --test-concurrency=4 benchmarks/mosaic/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["benchmark", "private"]
}
