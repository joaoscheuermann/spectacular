{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "studyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "family": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "replication",
        "sensitivity"
      ]
    },
    "datasetHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "freezeHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "implementationHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "formula": {
      "type": "string",
      "const": "success ~ condition * composition_class + (1 | case_id)"
    },
    "estimator": {
      "type": "string",
      "enum": [
        "glmer-bobyqa",
        "glmer-nloptwrap",
        "glm-hc2-cluster",
        "case-bootstrap",
        "not-estimable"
      ]
    },
    "estimable": {
      "type": "boolean"
    },
    "validFitRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observations": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "cases": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "contrasts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "estimate": {
            "type": "number"
          },
          "oddsRatio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "oddsRatioConfidence95": {
            "type": "object",
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            },
            "required": [
              "lower",
              "upper"
            ],
            "additionalProperties": false
          },
          "absoluteDifference": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "absoluteDifferenceConfidence95": {
            "type": "object",
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            },
            "required": [
              "lower",
              "upper"
            ],
            "additionalProperties": false
          },
          "pValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "holmPValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "estimate",
          "oddsRatio",
          "oddsRatioConfidence95",
          "absoluteDifference",
          "absoluteDifferenceConfidence95",
          "pValue",
          "holmPValue"
        ],
        "additionalProperties": false
      }
    },
    "power": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "simulations": {
              "type": "number",
              "const": 10000
            },
            "seed": {
              "type": "string",
              "minLength": 1
            },
            "numericSeed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "configHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "baselineProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "randomInterceptSd": {
              "type": "number",
              "minimum": 0
            },
            "adaptiveClasses": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ]
              }
            },
            "nPower": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "nFinal": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "power": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minimumEffect": {
              "type": "number",
              "const": 0.1
            }
          },
          "required": [
            "simulations",
            "seed",
            "numericSeed",
            "configHash",
            "baselineProbability",
            "randomInterceptSd",
            "adaptiveClasses",
            "nPower",
            "nFinal",
            "power",
            "minimumEffect"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "resultHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "studyId",
    "family",
    "datasetHash",
    "freezeHash",
    "implementationHash",
    "formula",
    "estimator",
    "estimable",
    "validFitRate",
    "observations",
    "cases",
    "contrasts",
    "power",
    "warnings",
    "resultHash"
  ],
  "additionalProperties": false
}
