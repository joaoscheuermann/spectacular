{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "familyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "calibration",
        "pilot",
        "confirmatory",
        "replication",
        "smoke"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "documents-finance",
        "software",
        "artifacts",
        "communication"
      ]
    },
    "compositionClass": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "focusGoalRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "composition": {
      "type": "object",
      "properties": {
        "skillCount": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "string",
              "const": "many"
            }
          ]
        },
        "toolRequirement": {
          "type": "string",
          "enum": [
            "none",
            "base",
            "declared",
            "mixed"
          ]
        },
        "toolCount": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "string",
              "const": "many"
            }
          ]
        },
        "requiresRevision": {
          "type": "boolean"
        },
        "requiresExternalEffect": {
          "type": "boolean"
        }
      },
      "required": [
        "skillCount",
        "toolRequirement",
        "toolCount",
        "requiresRevision",
        "requiresExternalEffect"
      ],
      "additionalProperties": false
    },
    "adaptive": {
      "type": "boolean"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "fixtureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "gold": {
      "type": "object",
      "properties": {
        "criteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              }
            },
            "required": [
              "id",
              "description",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        },
        "requiredSkills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "relevantSkills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "forbiddenSkills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "forbiddenTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "expectedState": {
          "type": "object",
          "properties": {
            "fixtureId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "worldHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "toolEvidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "input": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "evidenceHash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "input",
                  "evidenceHash"
                ],
                "additionalProperties": false
              }
            },
            "requiredEffects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          },
          "required": [
            "fixtureId",
            "worldHash",
            "toolEvidence",
            "requiredEffects"
          ],
          "additionalProperties": false
        },
        "expectedDelivery": {
          "type": "object",
          "properties": {
            "document": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "fields": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "path": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "document",
            "fields"
          ],
          "additionalProperties": false
        },
        "requiresRevision": {
          "type": "boolean"
        }
      },
      "required": [
        "criteria",
        "requiredSkills",
        "relevantSkills",
        "forbiddenSkills",
        "requiredTools",
        "forbiddenTools",
        "expectedState",
        "expectedDelivery",
        "requiresRevision"
      ],
      "additionalProperties": false
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "familyId",
    "phase",
    "title",
    "domain",
    "compositionClass",
    "focusGoalRole",
    "composition",
    "adaptive",
    "request",
    "fixtureIds",
    "tags",
    "gold",
    "contentHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
