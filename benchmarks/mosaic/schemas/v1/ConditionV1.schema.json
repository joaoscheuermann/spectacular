{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "baseline",
        "mosaic",
        "ablation",
        "oracle",
        "smoke"
      ]
    },
    "eligibility": {
      "type": "string",
      "enum": [
        "all",
        "failures-only",
        "opt-in"
      ]
    },
    "factors": {
      "type": "object",
      "properties": {
        "decomposition": {
          "type": "string",
          "enum": [
            "none",
            "task",
            "goal"
          ]
        },
        "catalogFeedback": {
          "type": "boolean"
        },
        "skillView": {
          "type": "string",
          "enum": [
            "none",
            "metadata",
            "body"
          ]
        },
        "retrieval": {
          "type": "string",
          "enum": [
            "none",
            "top-k",
            "oracle"
          ]
        },
        "maxSkills": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle": {
          "type": "string",
          "enum": [
            "none",
            "single",
            "selective",
            "top-k",
            "oracle"
          ]
        },
        "bundleOrder": {
          "type": "string",
          "enum": [
            "not-applicable",
            "ranked",
            "shuffled"
          ]
        },
        "menu": {
          "type": "string",
          "enum": [
            "global",
            "declared",
            "base-plus-bundle",
            "oracle"
          ]
        },
        "baseTools": {
          "type": "boolean"
        },
        "localizedRevision": {
          "type": "boolean"
        }
      },
      "required": [
        "decomposition",
        "catalogFeedback",
        "skillView",
        "retrieval",
        "maxSkills",
        "bundle",
        "bundleOrder",
        "menu",
        "baseTools",
        "localizedRevision"
      ],
      "additionalProperties": false
    },
    "declaredChange": {
      "type": "string",
      "minLength": 1
    },
    "oracleFor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "label",
    "description",
    "kind",
    "eligibility",
    "factors",
    "declaredChange"
  ],
  "additionalProperties": false
}
