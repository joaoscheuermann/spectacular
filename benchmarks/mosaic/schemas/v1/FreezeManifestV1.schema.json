{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "studyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "cleanWorktree": {
      "type": "boolean",
      "const": true
    },
    "primaryModel": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "model": {
          "type": "string",
          "const": "openai/gpt-5.6-luna"
        },
        "effort": {
          "type": "string",
          "const": "medium"
        }
      },
      "required": [
        "provider",
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "reranker": {
      "type": "string",
      "const": "voyageai/rerank-2.5-lite"
    },
    "embedder": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "const": "voyageai/voyage-4-large"
        },
        "dimensions": {
          "type": "number",
          "const": 2048
        }
      },
      "required": [
        "model",
        "dimensions"
      ],
      "additionalProperties": false
    },
    "selectedBaseline": {
      "type": "string",
      "enum": [
        "B0",
        "B1",
        "B2",
        "B3"
      ]
    },
    "repetitions": {
      "type": "number",
      "const": 5
    },
    "alpha": {
      "type": "number",
      "const": 0.05
    },
    "minimumEffect": {
      "type": "number",
      "const": 0.1
    },
    "targetPower": {
      "type": "number",
      "const": 0.8
    },
    "nPower": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "nFinal": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "modelCallBudgetP95": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "semanticReviewFraction": {
      "type": "number",
      "const": 0.2
    },
    "artifactHashes": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "schemas": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "catalog": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tools": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pilotCases": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pilotScores": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "confirmatoryCases": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "conditions": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "prompts": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "prices": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "seeds": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "calibration": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "calibrationAudit": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "confirmatoryAudit": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "costApproval": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "powerConfig": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "powerApproval": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "powerResult": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "retrievalIndex": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "analysis": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "renvLock": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocol",
        "schemas",
        "catalog",
        "tools",
        "pilotCases",
        "pilotScores",
        "confirmatoryCases",
        "conditions",
        "prompts",
        "prices",
        "seeds",
        "calibration",
        "calibrationAudit",
        "confirmatoryAudit",
        "costApproval",
        "powerConfig",
        "powerApproval",
        "powerResult",
        "retrievalIndex",
        "analysis",
        "renvLock"
      ],
      "additionalProperties": false
    },
    "replication": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "const": "medium"
            }
          },
          "required": [
            "provider",
            "model",
            "effort"
          ],
          "additionalProperties": false
        },
        "neutralCases": {
          "type": "number",
          "const": 60
        },
        "repetitions": {
          "type": "number",
          "const": 3
        },
        "difference": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "confidence95": {
          "type": "object",
          "properties": {
            "lower": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "required": [
            "lower",
            "upper"
          ],
          "additionalProperties": false
        },
        "approved": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "candidate",
        "neutralCases",
        "repetitions",
        "difference",
        "confidence95",
        "approved"
      ],
      "additionalProperties": false
    },
    "containerDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "studyId",
    "frozenAt",
    "gitCommit",
    "cleanWorktree",
    "primaryModel",
    "reranker",
    "embedder",
    "selectedBaseline",
    "repetitions",
    "alpha",
    "minimumEffect",
    "targetPower",
    "nPower",
    "nFinal",
    "modelCallBudgetP95",
    "semanticReviewFraction",
    "artifactHashes",
    "replication",
    "containerDigest",
    "manifestHash"
  ],
  "additionalProperties": false
}
