{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "studyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "calibration",
        "pilot",
        "confirmatory",
        "replication",
        "smoke"
      ]
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "familyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "conditionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repetition": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pairedBlock": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "freezeHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "traceRootHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "traceDerivedHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "worldHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "modelCallBudget": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "documents-finance",
        "software",
        "artifacts",
        "communication"
      ]
    },
    "compositionClass": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "adaptive": {
      "type": "boolean"
    },
    "success": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "primaryEligible": {
      "type": "boolean"
    },
    "infrastructure": {
      "type": "boolean"
    },
    "failureCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "recallAtK": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ndcg": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "k": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recallAtK",
            "ndcg",
            "k"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "bundleExact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "menuExact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "observationExact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "modelCalls": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "toolCalls": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "attempt",
    "studyId",
    "phase",
    "caseId",
    "familyId",
    "conditionId",
    "repetition",
    "pairedBlock",
    "provider",
    "model",
    "effort",
    "freezeHash",
    "traceRootHash",
    "traceDerivedHash",
    "evidenceHash",
    "worldHash",
    "modelCallBudget",
    "domain",
    "compositionClass",
    "adaptive",
    "success",
    "primaryEligible",
    "infrastructure",
    "failureCode",
    "retrieval",
    "bundleExact",
    "menuExact",
    "observationExact",
    "inputTokens",
    "outputTokens",
    "modelCalls",
    "toolCalls",
    "costUsd",
    "durationMs"
  ],
  "additionalProperties": false
}
