{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-git",
  "projectType": "library",
  "sourceRoot": "bundles/git",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/agents/doric/dist/bundles/git"],
      "options": {
        "outputPath": "agents/doric/dist/bundles/git",
        "main": "bundles/git/index.mts",
        "tsConfig": "bundles/git/tsconfig.json",
        "assets": [
          { "input": "bundles/git", "glob": "manifest.json", "output": "." },
          {
            "input": "bundles/git",
            "glob": "skills/**/SKILL.md",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build bundles/git/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p bundles/git/tsconfig.spec.json",
          "node --test bundles/git/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
