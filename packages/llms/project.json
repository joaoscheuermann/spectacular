{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "llms",
  "projectType": "library",
  "sourceRoot": "packages/llms/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/llms/tsconfig.spec.json",
          "node --test $(find packages/llms/tests -maxdepth 1 -name '*.test.ts' -print | sort | sed 's#^packages/llms/tests/#packages/llms/dist-tests/tests/#; s#\\.ts$#.js#')"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
