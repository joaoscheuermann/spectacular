      "default": "./dist/src/evaluation.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "agent": "0.0.1",
    "bundle": "0.0.1",
    "llms": "0.0.1",
    "messages": "0.0.1",
    "pino": "^10.3.1",
    "state-machine": "0.0.1",
    "tool": "0.0.1",
    "tslib": "^2.3.0",
    "victor": "0.0.1",
    "zod": "^4.4.3"
  }
}
