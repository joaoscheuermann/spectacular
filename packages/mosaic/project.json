{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mosaic",
  "projectType": "library",
  "sourceRoot": "packages/mosaic/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "packages/mosaic/dist",
        "main": "packages/mosaic/src/index.ts",
        "tsConfig": "packages/mosaic/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/mosaic/tsconfig.spec.json",
          "node --test packages/mosaic/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
